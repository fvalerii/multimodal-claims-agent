# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- API keys (set the one for the provider you use) ------------------------
ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# --- Provider / model selection (all optional) ------------------------------
# If ANTHROPIC_API_KEY is set, the pipeline defaults to Anthropic; otherwise
# it falls back to Google. Override explicitly with VISION_PROVIDER.
# VISION_PROVIDER=anthropic        # anthropic | google
# ANTHROPIC_MODEL=claude-sonnet-4-5
# GEMINI_MODEL=gemini-2.5-flash
